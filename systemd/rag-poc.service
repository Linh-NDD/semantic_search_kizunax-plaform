[Unit]
Description=Lightweight RAG PoC FastAPI
After=network.target qdrant-rag.service
Requires=qdrant-rag.service

[Service]
Type=simple
WorkingDirectory=/opt/rag
ExecStart=/opt/rag/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8088
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
